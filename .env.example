# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# Default brain for agents. You can change the provider and model of each agent
# in the UI ("🧠 Agent Models" panel); those choices are saved and override this default.
#   claude  = Claude via Claude Code CLI login   (run `claude` once and log in)
#   chatgpt = ChatGPT via Codex CLI login        (npm i -g @openai/codex, then `codex login`)
#   openai  = any OpenAI-compatible API (configure OPENAI_* below)
#   mixed   = agents alternate Claude / ChatGPT
LLM_PROVIDER=mixed
CLAUDE_MODEL=haiku
# Model suggestions shown in the UI (comma-separated; any valid id can still be typed)
CLAUDE_MODELS=haiku,sonnet,opus
# Empty = Codex CLI default model
CODEX_MODEL=
CODEX_MODELS=

# OpenAI-compatible API (OpenAI, OpenRouter, Groq, Together, LM Studio, vLLM, ...).
# The key stays on the server; the UI only ever sees model names.
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   LM Studio:  http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: model suggestions if the endpoint has no /models list
OPENAI_MODELS=
# Optional: an embedding model on the same endpoint enables semantic memory search (e.g. text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=
# Pause after each agent thought (ms). Every thought uses your subscription quota.
THINK_COOLDOWN_MS=30000

# How many agents may wait on the LLM at once (the office has 10 agents). Lower = less quota burst.
MAX_CONCURRENT_THINKS=3
# Run only part of the team, e.g. ACTIVE_AGENTS=alice,bob,citra,dimas (empty = everyone, see packages/server/src/agents.ts)
ACTIVE_AGENTS=
# The server has no authentication and listens on 127.0.0.1 by default. Set HOST=0.0.0.0 only on a trusted network.
HOST=
# Where agents read and write notes (default: packages/server/workspace)
AGENT_WORKSPACE=
