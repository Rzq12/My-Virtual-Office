# Tavily API key (optional) — enables Tavily web search for agents.
# When set, web_search calls use Tavily; otherwise DuckDuckGo is used as fallback.
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# Which brain the agents use (no API keys — uses your logged-in CLIs):
#   claude  = Claude via Claude Code CLI login   (run `claude` once and log in)
#   chatgpt = ChatGPT via Codex CLI login        (npm i -g @openai/codex, then `codex login`)
#   mixed   = agents alternate Claude / ChatGPT
#   ollama  = local Ollama
LLM_PROVIDER=mixed
CLAUDE_MODEL=haiku
# Empty = Codex CLI default model
CODEX_MODEL=
# Pause after each agent thought (ms). Every thought uses your subscription quota.
THINK_COOLDOWN_MS=30000

# How many agents may wait on the LLM at once (the office has 10 agents). Lower = less quota burst.
MAX_CONCURRENT_THINKS=3
# Run only part of the team, e.g. ACTIVE_AGENTS=alice,bob,citra,dimas (empty = everyone, see packages/server/src/agents.ts)
ACTIVE_AGENTS=
# The server has no authentication and listens on 127.0.0.1 by default. Set HOST=0.0.0.0 only on a trusted network.
HOST=
# Where agents read and write notes (default: packages/server/workspace)
AGENT_WORKSPACE=
